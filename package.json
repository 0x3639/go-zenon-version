{
  "name": "go-zenon-version",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "generate": "node scripts/generate-assets.ts && node scripts/generate-site.ts",
    "build": "npm run generate && tsc --noEmit && vite build && node scripts/verify-site.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test tests/*.test.ts",
    "collect": "node scripts/collect.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "marked": "18.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
