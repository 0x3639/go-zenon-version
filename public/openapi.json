{
  "openapi": "3.1.0",
  "info": {
    "title": "Zenon Observatory Discovery API",
    "version": "1.2.0",
    "description": "Read-only observations, not a full network census. Version strings are self-reported; unsuccessful handshakes do not prove a peer is offline. Cache peer data and normally poll at most once per minute; momentum projections may be polled every ten seconds and production history every thirty seconds."
  },
  "servers": [
    {
      "url": "https://tw7v2v7y9rjq7mle1isnlktq.172.245.238.165.sslip.io"
    }
  ],
  "security": [],
  "externalDocs": {
    "description": "Usage, evidence semantics, and LLM instructions",
    "url": "https://0x3639.com/go-zenon-version/guide/"
  },
  "paths": {
    "/api/v1/network": {
      "get": {
        "operationId": "getSnapshot",
        "summary": "Get one coherent network observation snapshot",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ETag from a prior response to this same URL."
          }
        ],
        "responses": {
          "200": {
            "description": "Get one coherent network observation snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged; reuse the prior response body."
          },
          "503": {
            "description": "Source unavailable or warming up; retry later. Momentum responses may retain historical slots with their original timestamp. This is not a count of the network.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          }
        }
      }
    },
