    "/api/v1/production/gaps": {
      "get": {
        "operationId": "getGapStudy",
        "summary": "Compare later projected slots for fixed first-hour production groups; not proof of a fork",
        "responses": {
          "200": {
            "description": "No-store study. Windows are inclusive/exclusive Unix seconds, null while waiting. all includes excluded rounds; comparable and pillar/group counts exclude them. Current weights are not authoritative historical elections. Check timestamps and status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GapStudy"
                }
              }
            }
          },
          "503": {
            "description": "Production database unavailable."
          }
        }
      }
    },
    "/api/v1/production": {
      "get": {
        "operationId": "getProduction",
        "summary": "Get actual production since the inclusive configured timestamp; partial/stale status is independent of peer discovery",
        "responses": {
          "200": {
            "description": "No-store snapshot; errors preserve prior generation time. Check status and complete.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductionSnapshot"
                }
              }
            }
          },
          "503": {
            "description": "Production database unavailable."
          }
        }
      }
    },
    "/api/v1/production/momentums": {
      "get": {
        "operationId": "getProductionHistory",
        "summary": "Page through saved intervals at a fixed checked tip",
        "parameters": [
          {
            "name": "tipHeight",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "tipHash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "beforeHeight",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Exclusive descending cursor. Start with last.height + 1, then use nextBeforeHeight; null ends paging."
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "At most limit records in descending height order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductionPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query."
          },
          "409": {
            "description": "Pinned tip is no longer present. Return to latest."
          },
          "503": {
            "description": "History is unavailable."
          }
        }
      }
    }
  },
